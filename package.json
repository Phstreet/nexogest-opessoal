    "test:pwa:production": "PLAYWRIGHT_PWA_PRODUCTION=true playwright test tests/pwa.spec.ts"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@sentry/nextjs": "^11.17.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.4.15",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "postcss": "8.5.33",
    "tailwindcss": "3.3.3",
    "typescript": "5.2.2",
    "sharp": "^0.35.5"
  },
  "overrides": {
