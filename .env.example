# Supabase Auth e sincronização (publishable key no cliente).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Aliases opcionais, somente para o servidor Next.js.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# URL pública usada para metadados e links absolutos.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Sentry — DSN público do projeto; pode ser usado no browser e no servidor.
NEXT_PUBLIC_SENTRY_DSN=

# Sentry — segredos somente no servidor e no ambiente de build da Vercel.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Token temporário para a rota POST /api/sentry-test.
# Remova a rota e esta variável depois de validar o recebimento de um evento.
SENTRY_TEST_TOKEN=

# Nunca configure SUPABASE_SERVICE_ROLE_KEY nem chaves secret em NEXT_PUBLIC_*.
