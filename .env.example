# Configuração pública do Supabase (a publishable key é apropriada para uso no cliente).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Aliases opcionais, somente para o servidor Next.js.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# URL pública usada para metadados e links absolutos da aplicação.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Nunca configure SUPABASE_SERVICE_ROLE_KEY nem secret keys em NEXT_PUBLIC_*.
